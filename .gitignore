# Dotfiles / dot directories (.env, .vscode, .DS_Store, etc.)
.*
!.gitignore
!.env.example
!.github/
!.node-version
!.vscode/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.pre-commit-config.yaml
!.terraform-version
!.terraform.lock.hcl

# OS
Thumbs.db

# Dependencies
node_modules/

# Build output
dist/
build/
out/

# Logs
*.log

# Editors
*.swp

# Terraform
# (.terraform/ is already ignored by .*)
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
crash.log
crash.*.log
*.tfplan
backend.hcl
override.tf
override.tf.json
*_override.tf
*_override.tf.json
