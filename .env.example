# Copy to .env and fill in your values, then load with: source .env
# .env is ignored by git. Do not commit real values.

# AWS
export AWS_PROFILE=your-profile-name   # profile name in ~/.aws/config
export AWS_REGION=ap-northeast-1

# Terraform variables (TF_VAR_<name> -> var.<name>)
# export TF_VAR_aws_account_id=000000000000
